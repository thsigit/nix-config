#!/usr/bin/env bash
# litellm-add-provider — register a new provider (no rebuild)
#
# Registers a provider in providers.json AND, optionally, seeds its models into
# models.json so it can serve immediately — all without nixos-rebuild.
#
# Usage:
#   litellm-add-provider <name> <api_base> <api_key_env> <prefix> [models_endpoint]
#   litellm-add-provider <name> <api_base> <api_key_env> <prefix> [models_endpoint] \
#       --models '[{"id":"m1","name":"Model One"},...]'
#
# With --models, the given model list is merged into models.json under <name>
# (each entry gets origin.type=manual + origin.added_at). Without --models, the
# provider is registered but serves nothing until its models exist in models.json
# (via fetch-models rebuild or a later --models call).
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Error: this command must be run as root (sudo)"
  exit 1
fi

if [ $# -lt 4 ]; then
  echo "Usage: litellm-add-provider <name> <api_base> <api_key_env> <prefix> [models_endpoint] [--models '<json array>']"
  exit 1
fi

NAME="$1"
API_BASE="$2"
KEY_ENV="$3"
PREFIX="$4"
MODELS_EP="${5:-/models}"
shift 5 2>/dev/null || shift $# || true

MODELS_JSON_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --models) MODELS_JSON_ARG="$2"; shift 2 ;;
    *) echo "Unknown argument: $1"; exit 1 ;;
  esac
done

STATE_DIR="${LITELLM_STATE_DIR:-/srv/appdata/litellm}"
PROVIDERS_JSON="${LITELLM_PROVIDERS_JSON:-$STATE_DIR/providers.json}"
MODELS_JSON="${LITELLM_MODELS_JSON:-$STATE_DIR/models.json}"
LOCK_FILE="$STATE_DIR/providers.json.lock"
exec 9>"$LOCK_FILE"
if ! flock -x -w 5 9; then
  echo "Error: another process is modifying $PROVIDERS_JSON. Try again."
  exit 1
fi

if [ ! -f "$PROVIDERS_JSON" ]; then
  echo "Error: $PROVIDERS_JSON not found"
  exit 1
fi

if jq -e "has(\"$NAME\")" "$PROVIDERS_JSON" >/dev/null 2>&1; then
  echo "Error: provider '$NAME' already exists"
  exit 1
fi

jq --arg name "$NAME"    --arg api_base "$API_BASE"    --arg key_env "$KEY_ENV"    --arg prefix "$PREFIX"    --arg models_ep "$MODELS_EP"    '.[$name] = {
     enabled: true,
     connection: {
       api_base: $api_base,
       api_key_env: $key_env,
       prefix: $prefix
     },
     endpoints: { models: $models_ep },
     policy: { priority: 50, disabled_models: [] }
   }' "$PROVIDERS_JSON" > "$PROVIDERS_JSON.tmp"   && mv "$PROVIDERS_JSON.tmp" "$PROVIDERS_JSON"

echo "Added provider: $NAME (enabled)"

if [ -n "$MODELS_JSON_ARG" ]; then
  if [ ! -f "$MODELS_JSON" ]; then
    echo "Error: $MODELS_JSON not found — cannot seed models"
    exit 1
  fi
  if ! echo "$MODELS_JSON_ARG" | jq -e 'type == "array"' >/dev/null 2>&1; then
    echo "Error: --models must be a JSON array"
    exit 1
  fi
  ADDED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  COUNT=$(echo "$MODELS_JSON_ARG" | jq 'length')
  jq --arg name "$NAME" --arg added "$ADDED_AT" --argjson models "$MODELS_JSON_ARG" '
    ($models | map(. + { origin: { type: "manual", added_at: $added } })) as $seed
    | if has($name) then
        .[$name].models += $seed
      else
        .[$name] = { source: "manual", models: $seed }
      end
  ' "$MODELS_JSON" > "$MODELS_JSON.tmp"     && mv "$MODELS_JSON.tmp" "$MODELS_JSON"
  echo "Seeded $COUNT model(s) into $MODELS_JSON under '$NAME'."
else
  echo "Note: provider serves nothing until its models exist in models.json."
  echo "      Re-run with --models '[...]' to seed them now (no rebuild)."
fi

echo "litellm-config will auto-restart the podman-litellm container shortly (via path unit)."
echo "Done."
