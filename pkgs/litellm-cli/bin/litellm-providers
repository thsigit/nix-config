#!/usr/bin/env bash
# litellm-providers — list all providers with enabled/disabled status + model count
set -euo pipefail

export PATH="@jq@/bin:@coreutils@/bin:$PATH"

STATE_DIR="${LITELLM_STATE_DIR:-/srv/appdata/litellm}"
PROVIDERS_JSON="${LITELLM_PROVIDERS_JSON:-$STATE_DIR/providers.json}"
MODELS_JSON="${LITELLM_MODELS_JSON:-$STATE_DIR/models.json}"

echo "litellm providers — provider registry"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ ! -f "$PROVIDERS_JSON" ]; then
  echo "No providers.json found. Run: sudo nixos-rebuild switch"
  exit 0
fi

jq -r '
  to_entries[] | .key as $p
  | .value.enabled as $enabled
  | ($enabled | if . then "✓ enabled  " else "○ disabled " end) as $mark
  | "  \($mark) \($p)"
' "$PROVIDERS_JSON"

echo
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Use litellm-enable-provider / litellm-disable-provider to manage"
