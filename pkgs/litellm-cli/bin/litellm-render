#!/usr/bin/env bash
# litellm-render — pure join of models.json (inventory) + providers.json (policy)
# into config.yaml (LiteLLM backend config), with routing from router.yaml.
#
# The renderer contains NO provider-specific knowledge. Every provider behavior
# (api_base, prefix, endpoints) is expressed as data in providers.json.
# Routing (capabilities + logical model definitions) comes from router.yaml.
#
# Model provenance (origin.type / origin.discovered_at / origin.added_at) from
# models.json is preserved verbatim into each rendered entry under meta,
# so the generated config carries its own audit trail.
set -euo pipefail

export PATH="@jq@/bin:@coreutils@/bin:@yq@/bin:$PATH"

STATE_DIR="${LITELLM_STATE_DIR:-/srv/appdata/litellm}"
MODELS_JSON="${LITELLM_MODELS_JSON:-$STATE_DIR/models.json}"
PROVIDERS_JSON="${LITELLM_PROVIDERS_JSON:-$STATE_DIR/providers.json}"
ROUTER_YAML="${LITELLM_ROUTER_YAML:-$STATE_DIR/router.yaml}"
CONFIG_FILE="${LITELLM_CONFIG_YAML:-$STATE_DIR/config.yaml}"

if [ ! -f "$MODELS_JSON" ]; then
  echo "litellm-render: $MODELS_JSON not found, skipping"
  exit 0
fi

if [ ! -f "$PROVIDERS_JSON" ]; then
  echo "litellm-render: $PROVIDERS_JSON not found, skipping"
  exit 0
fi

# ── Build model_list (existing join) ──────────────────────────────────
MODELS=$(jq -n --slurpfile models "$MODELS_JSON" --slurpfile providers "$PROVIDERS_JSON" '
  [$providers[0] | to_entries[]
   | select(.value.enabled == true)
   | .key as $provider
   | .value as $policy
   | ($models[0][$provider].models // []) as $inventory
   | ($policy.policy.disabled_models // []) as $disabled
   | ($policy.connection.api_base) as $api_base
   | ($policy.connection.api_key_env) as $key_env
   | ($policy.connection.prefix // null) as $prefix
   | $inventory
   | map(select(.id as $id | ($disabled | index($id)) | not))
   | map({
       model_name: ($provider + "/" + .id),
       litellm_params: {
         model: (if $prefix != null then $prefix + "/" + .id else .id end),
         api_base: $api_base,
         api_key: (if $key_env != null then ("os.environ/" + $key_env) else null end)
       },
       meta: {
         provider: $provider,
         origin: (.origin // null)
       }
     })]
  | add // []
')

MODEL_COUNT=$(echo "$MODELS" | jq 'length')

if [ "$MODEL_COUNT" -eq 0 ]; then
  echo "litellm-render: ERROR — no models after join" >&2
  echo "litellm-render: providers: $PROVIDERS_JSON" >&2
  exit 1
fi

# Build a lookup table: model_name → {api_base, api_key, provider, model}
# for resolving logical model definitions.
MODEL_LOOKUP=$(echo "$MODELS" | jq 'map({key: .model_name, value: {api_base: .litellm_params.api_base, api_key: .litellm_params.api_key, model: .litellm_params.model, provider: .meta.provider}}) | from_entries')

# ── Read router config ────────────────────────────────────────────────
ROUTER_JSON="{}"
if [ -f "$ROUTER_YAML" ]; then
  ROUTER_JSON=$(yq '.' "$ROUTER_YAML" 2>/dev/null || echo '{"_error": "yq parse failed"}')
  if echo "$ROUTER_JSON" | jq -e 'has("_error")' >/dev/null 2>&1; then
    echo "litellm-render: WARNING — failed to parse $ROUTER_YAML, skipping routing sections" >&2
    ROUTER_JSON='{}'
  fi
fi

CAPABILITIES=$(echo "$ROUTER_JSON" | jq '.capabilities // {}')
LOGICAL_MODELS=$(echo "$ROUTER_JSON" | jq '.models // {}')

# ── Build model_alias: logical ID → actual model_name ────────────────
# For each logical model definition, resolve provider/model to a
# model_name from the model_list (provider/actual_model_id).
MODEL_ALIAS_JSON=$(echo "$LOGICAL_MODELS" | jq --argjson lookup "$MODEL_LOOKUP" '
  to_entries
  | map(
      .key as $logical
      | (.value.provider + "/" + .value.model) as $target
      | if $lookup | has($target) then
          {key: $logical, value: $target}
        else
          # Warn by emitting a null — we filter these out below
          {key: $logical, value: null}
        end
    )
  | from_entries
  | with_entries(select(.value != null))
')

# ── Build fallbacks ───────────────────────────────────────────────────
# For each capability with fallback chain, resolve primary + fallbacks
# to actual model_names. Emit as LiteLLM fallback list.
FALLBACKS_JSON=$(echo "$CAPABILITIES" | jq --argjson aliases "$MODEL_ALIAS_JSON" '
  [to_entries[]
   | .value.primary as $primary
   | ($aliases[$primary]) as $primary_model
   | .value.fallback // []
   | map($aliases[.])
   | map(select(. != null))
   | select(length > 0)
   | {($primary_model): .}]
')

# ── Write config.yaml ─────────────────────────────────────────────────
{
  echo "# Auto-generated by litellm-render"
  echo "# Do not edit — derived from models.json + providers.json + router.yaml"
  echo ""
  echo "model_list:"
  echo "$MODELS" | jq -r '.[] |
    "  - model_name: \(.model_name)" +
    "\n    litellm_params:" +
    "\n      model: \(.litellm_params.model)" +
    "\n      api_base: \(.litellm_params.api_base)" +
    "\n      api_key: \(.litellm_params.api_key)" +
    (if .meta.origin != null
     then "\n    meta:" +
          "\n      provider: \(.meta.provider)" +
          "\n      origin: " + (.meta.origin | tojson)
     else "" end)
  '

  # model_alias section — logical IDs → model_names
  ALIAS_COUNT=$(echo "$MODEL_ALIAS_JSON" | jq 'length')
  if [ "$ALIAS_COUNT" -gt 0 ]; then
    echo ""
    echo "model_alias:"
    echo "$MODEL_ALIAS_JSON" | jq -r 'to_entries[] |
      "  \(.key): \(.value)"'
  fi

  # fallbacks section — primary → fallback chain
  FALLBACK_COUNT=$(echo "$FALLBACKS_JSON" | jq 'length')
  if [ "$FALLBACK_COUNT" -gt 0 ]; then
    echo ""
    echo "fallbacks:"
    echo "$FALLBACKS_JSON" | jq -r '.[] | to_entries[] |
      .key as $primary |
      "  - \($primary): [" + (.value | join(", ")) + "]"'
  fi

  # router_settings
  if [ "$ALIAS_COUNT" -gt 0 ] || [ "$FALLBACK_COUNT" -gt 0 ]; then
    echo ""
    echo "router_settings:"
    echo "  routing_strategy: usage-based-routing"
    echo "  num_retries: 2"
    echo "  enable_pre_call_checks: true"
  fi

  echo ""
  echo "litellm_settings:"
  echo "  json_logs: true"
  echo "  drop_params: true"
  echo ""
  echo "general_settings:"
  echo "  master_key: os.environ/LITELLM_MASTER_KEY"
# database_url disabled - sqlite not supported in litellm v1.92.0
} > "$CONFIG_FILE"

echo "litellm-render: wrote $CONFIG_FILE with $MODEL_COUNT models, $(echo "$MODEL_ALIAS_JSON" | jq 'length') aliases, $(echo "$FALLBACKS_JSON" | jq 'length') fallbacks"
